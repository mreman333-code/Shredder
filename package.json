{
  "name": "shredder",
  "private": true,
  "version": "1.0.0",
  "description": "Shredder — desktop character modeler with a local AI bridge",
  "author": "Shredder",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "dist:win": "npm run build && node scripts/package-win.mjs && node scripts/make-installer.mjs",
    "installer:win": "node scripts/make-installer.mjs",
    "icon:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "test": "node scripts/connector-test.cjs && node scripts/projects-test.mjs && node scripts/package-test.mjs",
    "test:models": "bun scripts/model-import-test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:installer": "node scripts/check-installer.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "^33.4.11",
    "typescript": "5.6.2",
    "vite": "5.4.8"
  }
}
